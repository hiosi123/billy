# ═══════════════════════════════════════════════════════════════════════════
# Billy 백엔드 환경변수
#
# ▸ 로컬 개발: 이 파일을 .env 로 복사해서 아래 [로컬] 값을 채운다.
# ▸ Railway 배포: .env 를 올리지 않는다. Railway 서비스 Variables 에 [Railway] 항목만 등록.
# ═══════════════════════════════════════════════════════════════════════════

# ── 데이터베이스 ───────────────────────────────────────────────
# [Railway] Postgres 플러그인 추가 후, 이 값에 참조변수를 넣는다:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL 이 있으면 아래 DB_* 개별값은 무시되고 SSL 이 자동 적용된다.
DATABASE_URL=

# [로컬] DATABASE_URL 을 비워두면 아래 개별값으로 접속한다.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=billy

# [공통] 스키마는 sql/schema.sql 로 만든다. 운영에서는 반드시 false 유지.
DB_SYNCHRONIZE=false

# ── 서버 ───────────────────────────────────────────────────────
# [Railway] PORT 는 Railway 가 자동 주입한다 → 설정하지 말 것.
# [로컬] 미설정 시 3000.
PORT=3000
NODE_ENV=development      # Railway 에서는 production

# ── JWT 인증 ───────────────────────────────────────────────────
# [Railway/로컬 공통·필수] 길고 무작위인 문자열. (예시는 새로 발급해 쓸 것)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d

# ── AI 사진 OCR (선택) ──────────────────────────────────────────
# 계량기/고지서 사진을 비전 AI로 자동 인식. OPENAI 또는 ANTHROPIC 중 하나.
# 둘 다 있으면 OpenAI 우선. 미설정 시 사진 기능만 비활성.
# OpenAI(저렴, 기본 gpt-4o-mini): platform.openai.com 에서 발급
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Anthropic(대안): console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── CORS ───────────────────────────────────────────────────────
# [Railway] 프론트 도메인으로 제한 권장. 예: https://billy-frontend.up.railway.app
# 설정 초기에는 * 로 열어두고, 프론트 배포 후 좁힌다.
CORS_ORIGIN=*
